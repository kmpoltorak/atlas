# Go build output in the repository root. Anchor binary names so source directories such as
# cmd/trainer and internal/infrastructure/trainer remain visible to Git and file searches.
/api
/atlas-api
/export-training-data
/trainer
*.exe
/bin/
/atlas

# Go test output: `go test -c` binaries and coverage profiles.
*.test
coverage.out

# Local env
.env
.env.*
!.env.example

# Logs
*.log

# Local backup dumps (e.g. from rehearsing docs/runbook.md's restore procedure)
*.dump

# IDE and editor leftovers
.vscode/
.idea/
*.swp
.DS_Store

# Merge/backup leftovers — a stray .orig or .bak is never source
*.orig
*.bak
*.rej

# Chat history
chat.json

# Claude
.claude

# Impeccable design-skill local state (critique snapshots) — tool-local, not project source
.impeccable

# ML training artifacts (locally/CI-generated, not committed source — see training/README.md)
training/.venv/
training/.venv-container/
training/data/
training/models/
__pycache__/
*.pyc
