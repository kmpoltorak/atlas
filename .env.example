# Copy this file to .env (already gitignored) and fill in real values.
#
# Atlas has no login. It is a local tool for one person: every port in docker-compose.yml is bound
# to 127.0.0.1, and anyone who can reach the dashboard can read and change everything in it. Do not
# publish it beyond this machine.
# `docker compose up` reads .env automatically — no extra flag needed.
#
# Every var below has a working default baked into docker-compose.yml, so `docker compose up`
# runs fine with no .env at all. This file exists so real values (passwords, webhook URLs) live
# outside Git instead of hardcoded in docker-compose.yml.

# Shared by atlas-api (DATABASE_PASSWORD) and timescaledb (POSTGRES_PASSWORD) — must be the same
# value for both, which is why it's one variable, not two.
DATABASE_PASSWORD=atlas

# Connection-pool bounds. Leave unset (or 0) for the defaults in
# internal/infrastructure/persistence.PoolLimits — 20 open, 5 idle, 30 minute lifetime. Those are
# conservative starting points, not measured optima: raise MAX_OPEN only if a real deployment
# shows requests queuing for a connection, and keep the total across every client below the
# database's own max_connections.
DATABASE_MAX_OPEN_CONNS=
DATABASE_MAX_IDLE_CONNS=
DATABASE_CONN_MAX_LIFETIME_MINUTES=

# Grafana's admin login (username stays "admin", only the password is configurable here).
GRAFANA_ADMIN_PASSWORD=admin

# Business alerts — recommendation changes for watched symbols (internal/app/alerts_loop.go).
# Any combination of the three below may be set; each configured channel gets every alert
# independently (internal/application/notifications/usecase.go). Leave all empty to disable
# notifications entirely (non-fatal — alert polling still runs and persists recommendations).
DISCORD_WEBHOOK_URL=
# Slack Incoming Webhook URL (Slack app settings -> Incoming Webhooks).
SLACK_WEBHOOK_URL=
# Telegram: create a bot via @BotFather for the token, then message the bot (or add it to a
# group) and read the chat id from https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A *separate* Discord webhook (ideally a different channel) for "is Atlas itself working"
# alerts: infra health (pod down/flapping, high error rate, alert-poll failures —
# prometheus/alerts.yml, routed via alertmanager/alertmanager.yml) and, if the atlas-trainer
# service is running, cmd/trainer's training-*failure* notification (read as
# TRAINING_DISCORD_WEBHOOK_URL, see docker-compose.yml) — a successful run only logs, it no longer
# pushes anywhere. Deliberately not the same webhook as DISCORD_WEBHOOK_URL above, so this
# operational noise never mixes with investment notifications. Leave empty and every consumer
# still starts fine — they just log a delivery failure instead of posting anywhere.
ALERTMANAGER_DISCORD_WEBHOOK_URL=

# Set to false to make BUY/SELL/HOLD scoring use the technical term alone (RSI/MACD/Bollinger/
# momentum) and skip the ML+Portfolio+Risk blend entirely. Model files, if configured below,
# still load and stay usable via /predict and the Settings page — this only stops the decision
# engine from factoring them in. True by default. This is only the startup default — an admin
# can flip it live from the Settings page without a restart; that choice, once made,
# overrides this value.
ML_ENABLED=true

# Optional: path (inside the container, under the training/models mount) to a trained ONNX model.
# Empty by default — Atlas falls back to the deterministic RSI stub (non-fatal).
MODEL_PATH=

# Optional: path to a trained recovery-probability ONNX model — fully independent of MODEL_PATH
# above (either, both, or neither can be set). Empty by default — recovery_probability stays 0
# (non-fatal). See training/README.md.
RECOVERY_MODEL_PATH=

# Where atlas-api reaches the atlas-trainer service, which `docker compose up` starts with the rest
# of the stack. Powers the Settings page's "Train new candidate" and model-delete buttons. Set it
# to an empty value to hide them; the page then explains how to run training/retrain.sh by hand.
# See training/README.md.
TRAINER_URL=http://atlas-trainer:8091

# Optional: password for Redis. Empty by default — this stack's Redis is on a private Compose
# network published on loopback only. Setting it here configures BOTH sides: the redis container
# starts with --requirepass and atlas-api authenticates with the same value, so they can't drift.
REDIS_PASSWORD=

# Days of recomputable history (indicators, recommendations, predictions) to keep; pruned once a
# day. 0 keeps everything, which is fine for a laptop. The alert loop writes one recommendation
# per watched symbol per poll — HOLD included — so set a real window on anything long-lived.
DERIVED_RETENTION_DAYS=0
